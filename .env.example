# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary → Settings → Upload → Upload presets (create an UNSIGNED preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
# Folder in your Cloudinary Media Library where uploads go
NEXT_PUBLIC_CLOUDINARY_FOLDER=fehintola-website

# Supabase → Project Settings → API → service_role key (SECRET – server only).
# Needed only for adding new team members from the admin. Never share it,
# never put NEXT_PUBLIC_ in front of it.

# Supabase service_role key – SECRET. Put the real value ONLY in .env.local and in Netlify, never here.
SUPABASE_SERVICE_ROLE_KEY=
